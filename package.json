{
  "name": "microvtt",
  "private": true,
  "description": "An offline, fully-featured, in-browser WebVTT editor.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @microvtt/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench": "node --expose-gc packages/core/bench/parse.bench.ts",
    "fuzz": "FUZZ_CASES=200000 vitest run packages/core/test/fuzz",
    "gen:entities": "node scripts/gen-entities.mjs",
    "gen:diagnostics": "node scripts/diagnostics-doc.mjs",
    "sync:wpt": "bash scripts/sync-wpt.sh",
    "sync:spec": "bash scripts/sync-spec.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "character-entities": "^2.0.2",
    "character-entities-legacy": "^3.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
