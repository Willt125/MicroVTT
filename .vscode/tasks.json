{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "detail": "Run the editor (Vite dev server)",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "test",
      "detail": "Unit and conformance tests (Vitest)",
      "type": "shell",
      "command": "pnpm test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "e2e (chromium)",
      "detail": "Browser tests in Chromium (Playwright)",
      "type": "shell",
      "command": "pnpm e2e --project=chromium",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "problemMatcher": "$tsc"
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "pnpm lint",
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "check (as CI)",
      "detail": "lint, typecheck, test and build, in CI's order",
      "dependsOrder": "sequence",
      "dependsOn": ["lint", "typecheck", "test", "build"],
      "problemMatcher": []
    }
  ]
}
